# ==============================================================================
# SkillUp - AI Career Development & Recruitment Intelligence Platform
# Developed by OmeGamma
# Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SkillUp"
PROJECT_TAGLINE="Build Skills. Predict Readiness. Unlock Opportunities."
DEVELOPED_BY="OmeGamma"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Replace in production)
SECRET_KEY="replace_with_a_secure_random_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080" # 7 days

# Optional source database for the one-time SQLite-to-MongoDB migration utility.
LEGACY_DATABASE_URL="sqlite:///./skillup.db"

# Optional: PostgreSQL Production Connection String
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/skillup"

# ==============================================================================
# MongoDB Primary Database (backend only; never expose this to the frontend)
# ==============================================================================
# Provide your MongoDB connection string below (supports MongoDB Atlas or local MongoDB)
# Percent-encode reserved characters in the username and password.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="skillup_db"

# Local Storage Paths (Relative to backend directory or absolute paths)
UPLOAD_DIR="./storage/uploads"
REPORTS_DIR="./storage/reports"
MODELS_DIR="./storage/models"
DATASETS_DIR="./storage/datasets"

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES="10485760" # 10MB
