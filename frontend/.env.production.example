# ==============================================================================
# SkillUp Frontend Production Environment Configuration
# ==============================================================================
# When deploying to production (e.g. Firebase Hosting, Vercel, Netlify),
# set this to your deployed FastAPI backend HTTPS URL followed by /api/v1.
#
# Examples:
#   VITE_API_BASE_URL="https://skillup-api.onrender.com/api/v1"
#   VITE_API_BASE_URL="https://skillup-backend-xyz.a.run.app/api/v1"
#
# Note: If you are using Firebase Hosting with a Cloud Run rewrite in firebase.json,
# you can leave this empty or omit it because Firebase rewrites /api directly to Cloud Run.
VITE_API_BASE_URL=""

